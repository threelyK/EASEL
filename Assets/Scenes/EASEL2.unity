    - target: {fileID: 6709930031608126436, guid: 3142a2d9a9135844196118b08a9bde1c, type: 3}
      propertyPath: OnLessonCompleteUnity.m_PersistentCalls.m_Calls.Array.data[3].m_Arguments.m_StringArgument
      value: 'In lesson 2 - They player has learnt about the agentic components:
        perception as a way for the agent to see its environment; tools as a way
        for the agent to interact with the environment; memory as a way to increase
        transparency by logging an agents actions; learning as in being able to self-optimise
        by analysing results of actions; and the most important one reasoning which
        is how the agent breaks down the goal into subtasks and actions.'
      objectReference: {fileID: 0}
